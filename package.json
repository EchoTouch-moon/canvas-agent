{
  "name": "canvas-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first project control system for AI coding agents",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @canvas-agent/desktop dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "pnpm --filter @canvas-agent/desktop format",
    "format:check": "pnpm --filter @canvas-agent/desktop format:check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
