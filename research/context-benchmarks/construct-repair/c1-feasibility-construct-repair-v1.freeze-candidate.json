  "criticalPrinciple": "Layer 3 may form a safety/observability gate or diagnosis, but must not alone define execution infeasibility without semantic consequence.",
  "falsifiableClaim": "Linkage quality and execution feasibility are related but non-equivalent constructs.",
  "validationProperties": [
    "constructSeparability",
    "deterministicAdjudication",
    "historicalNonInterference"
  ],
  "layers": {
    "layer1SemanticFeasibility": {
      "id": "L1",
      "role": "PRIMARY_FEASIBILITY_CONSTRUCT",
      "inputs": {
        "terminationStatus": {
          "enum": ["TERMINAL_COMPLETE", "TERMINAL_FAILED", "BUDGET_EXHAUSTED", "BLOCKED", "UNKNOWN"]
        },
        "objectiveOracleStatus": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "regressionOracleStatus": {
          "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]
        },
        "evidenceStatus": { "enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"] },
        "provenanceStatus": { "enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"] }
      },
      "rules": {
        "unknownIf": [
          "evidenceStatus != COMPLETE",
          "provenanceStatus != COMPLETE",
          "objectiveOracleStatus == UNKNOWN",
          "terminationStatus == UNKNOWN"
        ],
        "passIf": [
          "terminationStatus == TERMINAL_COMPLETE",
          "objectiveOracleStatus == PASS",
          "regressionOracleStatus in {PASS, NOT_APPLICABLE}",
          "evidenceStatus == COMPLETE",
          "provenanceStatus == COMPLETE"
        ],
        "failOtherwise": true
      },
      "outputs": {
        "semanticFeasibility": { "enum": ["PASS", "FAIL", "UNKNOWN"] }
      }
    },
    "layer2RecoveryTrajectory": {
      "id": "L2",
      "role": "TRAJECTORY_RECOVERY_CONSTRUCT",
      "inputs": {
        "toolFailureObserved": { "type": "boolean" },
        "semanticFeasibility": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "reachedTerminalComplete": {
          "derivation": "terminationStatus == TERMINAL_COMPLETE",
          "independentFixtureField": "FORBIDDEN"
        }
      },
      "rules": {
        "NOT_APPLICABLE_if": "toolFailureObserved == false",
        "UNKNOWN_if": "semanticFeasibility == UNKNOWN",
        "RECOVERED_if": [
          "toolFailureObserved == true",
          "reachedTerminalCompleteDerived == true",
          "semanticFeasibility == PASS"
        ],
        "UNRECOVERED_if": [
          "toolFailureObserved == true",
          "NOT (reachedTerminalCompleteDerived == true AND semanticFeasibility == PASS)"
        ]
      },
      "illegalState": {
        "name": "L1_PASS_AND_L2_UNRECOVERED",
        "policy": "FAIL_CLOSED",
        "reason": "L1 PASS requires TERMINAL_COMPLETE, which derives reachedTerminalComplete=true; with toolFailureObserved this forces L2 RECOVERED. Contradictory independent inputs are forbidden."
      },
      "explicitLegalState": {
        "name": "TRAJECTORY_RECOVERED_WITH_INCOMPLETE_TOOL_LINKAGE",
        "when": ["layer2 == RECOVERED", "layer3.linkageCompleteness == INCOMPLETE"],
        "meaning": "Task/oracle converged after tool failure, but strict per-tool recovery linkage metadata is incomplete. Legal under this contract; does not force Layer-1 FAIL."
      },
      "outputs": {
        "trajectoryRecoveryOutcome": {
          "enum": ["RECOVERED", "UNRECOVERED", "NOT_APPLICABLE", "UNKNOWN"]
        }
      }
    },
    "layer3ObservabilityLinkage": {
      "id": "L3",
      "role": "SAFETY_OR_OBSERVABILITY_DIAGNOSTIC",
      "inputs": {
        "toolFailureObserved": { "type": "boolean" },
        "strictPerToolRecoveryLinkageComplete": { "type": "boolean" },
        "missingRecoveryOfToolCallId": { "type": "boolean" },
        "recoveryAttemptOrdinalIntegrity": { "type": "boolean" }
      },
      "rules": {
        "NOT_APPLICABLE_if": "toolFailureObserved == false",
        "COMPLETE_if": [
          "toolFailureObserved == true",
          "strictPerToolRecoveryLinkageComplete == true",
          "missingRecoveryOfToolCallId == false",
          "recoveryAttemptOrdinalIntegrity == true"
        ],
        "INCOMPLETE_otherwise_when_toolFailureObserved": true
      },
      "outputs": {
        "linkageCompleteness": {
          "enum": ["COMPLETE", "INCOMPLETE", "NOT_APPLICABLE"]
        },
        "observabilityQuality": { "enum": ["PASS", "FAIL", "NOT_APPLICABLE"] }
      },
      "mapping": {
        "COMPLETE": { "observabilityQuality": "PASS" },
        "INCOMPLETE": { "observabilityQuality": "FAIL" },
        "NOT_APPLICABLE": { "observabilityQuality": "NOT_APPLICABLE" }
      },
      "forbiddenMapping": "INCOMPLETE must never alone set overallExecutionFeasibility=FAIL when semanticFeasibility=PASS and trajectoryRecoveryOutcome in {RECOVERED, NOT_APPLICABLE}"
    }
  },
  "composition": {
    "overallExecutionFeasibility": {
      "PASS_if": "semanticFeasibility == PASS AND trajectoryRecoveryOutcome in {RECOVERED, NOT_APPLICABLE}",
      "FAIL_if": "semanticFeasibility == FAIL",
      "UNKNOWN_if": "semanticFeasibility == UNKNOWN",
      "illegalState": "semanticFeasibility == PASS AND trajectoryRecoveryOutcome == UNRECOVERED",
      "illegalStatePolicy": "FAIL_CLOSED",
      "notes": "Overall feasibility uses L1 and L2. Layer 3 never alone sets overall FAIL when L1 PASS."
    }
  },
  "crossLayerTruthTable": [
